{
  "name": "mac-sounds",
  "version": "0.1.0",
  "description": "A terminal UI for browsing and playing macOS system sounds",
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "mac-sounds": "src/index.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run format:check"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "oxlint": "^1.82.0",
    "oxfmt": "^0.67.0",
    "typescript": "^7.0.2",
    "@types/react": "^19.2.18",
    "@types/bun": "^1.4.1"
  }
}
